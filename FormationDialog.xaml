<local:AbstractDialog x:Class="ScenarioEditor.FormationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScenarioEditor"
        Title="Formation" Height="200" Width="320"
        WindowStyle="None"
        KeyDown="WindowKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Name="Line"     Content="Line"          HorizontalAlignment="Stretch" Click="assign_lineFormation"/>
            <Button Grid.Row="0" Grid.Column="1" Name="Fight"    Content="Fight"         HorizontalAlignment="Stretch" Click="assign_fightingFormation"/>
            <Button Grid.Row="1" Grid.Column="0" Name="Walk"     Content="Walk"          HorizontalAlignment="Stretch" Click="assign_walkFormation"/>
            <Button Grid.Row="1" Grid.Column="1" Name="Square"   Content="Square"        HorizontalAlignment="Stretch" Click="assign_squareFormation"/>
            <Button Grid.Row="2" Grid.Column="0" Name="Assault"  Content="Assault"       HorizontalAlignment="Stretch" Click="assign_assaultFormation"/>
            <Button Grid.Row="2" Grid.Column="1" Name="Special"  Content="Special"       HorizontalAlignment="Stretch" Click="assign_specialFormation"/>
            <Button Grid.Row="3" Grid.Column="0" Name="Skirmish" Content="Skirmish"      HorizontalAlignment="Stretch" Click="assign_skirmishFormation"/>
            <Button Grid.Row="3" Grid.Column="1" Name="Alt"      Content="Alt Skirmish"  HorizontalAlignment="Stretch" Click="assign_alternativeSkirmishFormation"/>
            <Button Grid.Row="4" Grid.Column="0" Name="Half"     Content="Column Half"   HorizontalAlignment="Stretch" Click="assign_columnHalfDistanceFormation"/>
            <Button Grid.Row="4" Grid.Column="1" Name="Full"     Content="Column Full"   HorizontalAlignment="Stretch" Click="assign_columnFullDistanceFormation"/>
        </Grid>

        <Button Grid.Row="1" Content="Cancel" HorizontalAlignment="Stretch" Click="cancel_Click"/>
    </Grid>
</local:AbstractDialog>
